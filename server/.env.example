# Copy to .env and fill in. .env is never committed.

PORT=4000

# Arc testnet during the build; 5042 and https://rpc.mainnet.arc.io for the release
CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io

# Deployed PamoSavings (this is the Arc testnet deployment)
PAMO_SAVINGS_ADDRESS=0x9952E937378bb093DFA010e94FC81D56EC4cBF17

# Optional. The Earn Kit works without a key but shares a rate limit.
# Testnet and mainnet keys differ.
CIRCLE_API_KEY=

# CORS: the web app's origin (the Vercel domain in production)
ALLOWED_ORIGIN=http://localhost:3000

# Indexer and history routes. Leave all three empty to run without them.
# The service key is a secret: it goes here and on the host, never in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Block PamoSavings was deployed at; the indexer starts reading here (this is the Arc testnet deployment)
PAMO_SAVINGS_DEPLOY_BLOCK=66067781
