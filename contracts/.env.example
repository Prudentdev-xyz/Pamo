# Copy to .env and fill in. .env is never committed.

# Deployer key. Becomes the contract admin unless OWNER is set.
PRIVATE_KEY=

# Arc testnet during the build, https://rpc.mainnet.arc.io for the release
ARC_RPC_URL=https://rpc.testnet.arc.io

# Tier vaults. These are the two Arc testnet vaults (Calm and Bold share one there).
# Replace all three with the chosen mainnet vaults for the release.
CALM_VAULT=0xaabbef1d3971c710276ed41ec791bbe14cdb8e88
STEADY_VAULT=0x8f2d33b5d4b9b5f02df635ae308f7b4c9da8d2dc
BOLD_VAULT=0xaabbef1d3971c710276ed41ec791bbe14cdb8e88

# Optional: admin address if it should differ from the deployer
# OWNER=
